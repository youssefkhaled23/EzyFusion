{
  "name": "ezyfusion-assessment",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "pretypecheck": "next typegen",
    "test": "vitest run",
    "test:tz": "TZ=UTC vitest run && TZ=Asia/Kuala_Lumpur vitest run && TZ=America/New_York vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.mts",
    "db:check": "prisma validate && prisma generate && tsx scripts/check-prisma-schema.mts",
    "db:reset": "supabase db reset",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:api": "vitest run --config vitest.api.config.mts",
    "test:ui": "vitest run --config vitest.ui.config.mts"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright-core": "^1.64.1",
    "prisma": "^7.10.1",
    "shadcn": "^4.22.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  }
}
