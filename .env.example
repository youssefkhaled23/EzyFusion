# EzyFusion assessment: local development environment.
# Setup: cp .env.example .env.local   (.env.local is git-ignored)
#
# Every value below is a LOCAL-ONLY default produced by the Supabase CLI for the local stack
# (npx supabase start). They are the well-known development defaults, not real secrets, which is why they can
# be committed here. In any real deployment replace ALL of them and keep the server-only ones out of the browser.
# Get the live values at any time with:  npx supabase status -o env

# --- Browser-safe (prefixed NEXT_PUBLIC_, inlined into client bundles on purpose) -----------------------------
# Source: "Project URL" / API_URL from `npx supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Source: "Publishable" key (PUBLISHABLE_KEY) from `npx supabase status`. RLS protects every table; this key is public.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# --- SERVER-ONLY: never prefix with NEXT_PUBLIC_, never import from client components --------------------------
# Source: "Secret" key (SECRET_KEY) from `npx supabase status`. Bypasses RLS: Auth admin API, Storage admin, seeding.
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz
# Source: "Database URL" (DB_URL) from `npx supabase status`. Prisma connects as the database owner, which BYPASSES RLS.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct (non-pooled) connection used by Prisma CLI commands. Locally identical to DATABASE_URL (the pooler is off).
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# HMAC key the payment gateway uses to sign webhook calls (X-Signature). Local placeholder; the real key comes from the
# gateway merchant dashboard. Used only on the server.
GATEWAY_X_SIGNATURE_KEY=local-dev-gateway-x-signature-key-not-a-secret

# --- Seed ----------------------------------------------------------------------------------------------------------------
# All seeded accounts (manager@northwind.test, staff@northwind.test, aisyah@northwind.test, ben@northwind.test,
# probe@northwind.test, manager@beta.test, chen@beta.test) share this local test password. Server-side seed only.
SEED_PASSWORD=Passw0rd!local

# --- Gateway simulator (node gateway-sim.mjs <bill_id> <amount_sen> [true|false]) ---------------------------------------
# Optional. Where the simulator posts its signed callback (default shown). The simulator reads GATEWAY_X_SIGNATURE_KEY above.
# WEBHOOK_URL=http://localhost:3000/api/webhooks/gateway
